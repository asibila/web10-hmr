{
  "manifest_version": 3,
  "name": "Web10 Job Capture",
  "version": "0.3.0",
  "description": "Save the job ad you are reading to your local Web10 job index.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "Save this job to Web10",
    "default_popup": "popup.html"
  }
}
