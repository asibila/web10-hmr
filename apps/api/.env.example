# Local OpenCode server (see AGENTS.md)
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# One-shot job extraction model.
# Defaults work with the OpenCode Go subscription model used by this machine.
# For a fully local model, try: ollama / qwen3.5:9b
OPENCODE_MODEL_PROVIDER_ID=opencode-go
OPENCODE_MODEL_ID=deepseek-v4.1-flash
OPENCODE_MODEL_VARIANT=low

# Limits and timeout.
OPENCODE_TIMEOUT_MS=180000
OPENCODE_MAX_CONTENT_CHARS=30000
OPENCODE_MAX_JSONLD_CHARS=30000

# Local job index. Create the database once:
#   CREATE DATABASE web10 OWNER web10;
#   CREATE ROLE web10 LOGIN PASSWORD '...';
# The schema (table, generated search vector, indexes) is created at boot.
DATABASE_URL=postgresql://web10:change-me@127.0.0.1:5432/web10
# Set to 1/true for managed Postgres that requires TLS.
DATABASE_SSL=

# API listener.
# `HOST` defaults to 127.0.0.1, which keeps local runs private. Platforms that
# proxy traffic to the container (Render, Fly, Docker) need HOST=0.0.0.0,
# otherwise the port never becomes reachable from outside.
HOST=127.0.0.1
PORT=3000
